{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src/renderer/**/*", "src/core/**/*"],
  "exclude": ["src/core/engine.ts", "src/core/runners.ts"]
}
